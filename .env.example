# Copy to .env and fill in. Every secret comes from the environment, never from the code.

# --- Server ---
PORT=3000
NODE_ENV=development
# Comma separated list of allowed browser origins, or * during development.
CORS_ORIGINS=*
# Origin the admin console is served from, added to the CORS allow-list (ignored when
# CORS_ORIGINS is *). e.g. https://admin.derech-kohanim.example
ADMIN_ORIGIN=

# --- Admin console (/api/admin) ---
# Comma separated emails allowed into the admin console. Admins sign in through the normal
# Google auth flow to get a JWT; only these emails pass the AdminGuard. Empty means no admins.
ADMIN_EMAILS=

# --- Database ---
# Matches docker-compose.yml. Change the credentials there and here together.
DATABASE_URL=postgresql://derech:derech@localhost:5432/derech_kohanim
POSTGRES_USER=derech
POSTGRES_PASSWORD=derech
POSTGRES_DB=derech_kohanim
DB_PORT=5432
# Migrations and demo data run automatically on boot. Turn off in production.
RUN_MIGRATIONS_ON_BOOT=true
SEED_ON_BOOT=true

# --- Auth ---
# Change this. Anyone holding it can mint access tokens.
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Google Identity Services client id, used to verify ID tokens sent by the clients.
GOOGLE_CLIENT_ID=
# Extra audiences, e.g. the Android client id. Comma separated.
GOOGLE_EXTRA_CLIENT_IDS=
# Development only shortcut: POST /api/auth/dev-login returns tokens with no credential.
# Must stay false anywhere that is not a developer machine.
AUTH_DEV_LOGIN_ENABLED=true
AUTH_DEV_LOGIN_EMAIL=demo@derech-kohanim.local
# Password given to the seeded demo user.
SEED_DEMO_PASSWORD=derech1234

# --- Routing providers ---
# here | graphhopper | google | hybrid | mock. Falls back to any engine that has
# credentials, and finally to the offline mock, so the stack always starts.
ROUTING_PROVIDER=mock
HERE_API_KEY=
# Server side key. NOT the browser Maps JavaScript key: a referrer restricted key is
# rejected on server calls.
GOOGLE_ROUTES_API_KEY=
GRAPHHOPPER_API_KEY=
GRAPHHOPPER_URL=https://graphhopper.com/api/1/route
GRAPHHOPPER_SELF_HOSTED=false
# Which engine decides the shape in the hybrid engine: graphhopper (default) or here.
HYBRID_SHAPE_ENGINE=graphhopper

# --- Geocoding and Places ---
# Defaults to GOOGLE_ROUTES_API_KEY when empty. Each Google API is separate and must be
# enabled on the project: Geocoding API, Places API (New), Routes API.
GOOGLE_GEOCODING_API_KEY=
GEOCODING_REGION=il
# Google permits caching geocoding results for at most 30 days.
GEOCODE_CACHE_TTL_DAYS=30
# Server-side key for Places API (New) - named POI search. Defaults to GOOGLE_ROUTES_API_KEY.
GOOGLE_PLACES_API_KEY=
# Places content is cached conservatively: the place_id is durable, names/addresses are a
# short performance cache only.
PLACES_CACHE_TTL_DAYS=1

# --- Voice ---
VOICE_BASE_URL=/api/voice/clips
# Speech backend: "google" (real Cloud TTS, default) or "offline" (a synthetic tone
# generator for local development and for verifying the store-and-serve pipeline without a
# paid, enabled API). Offline audio is a beep, never real speech.
TTS_PROVIDER=google
# Server-side key for Google Cloud Text-to-Speech. Defaults to GOOGLE_ROUTES_API_KEY.
# The Text-to-Speech API must be enabled on the project, otherwise generation returns
# nothing and the client falls back to a shorter instruction.
GOOGLE_TTS_API_KEY=

# --- Live navigation thresholds ---
OFF_ROUTE_THRESHOLD_METERS=45
OFF_ROUTE_REPORTS_BEFORE_REROUTE=2
ARRIVAL_THRESHOLD_METERS=40
ZONE_ALERT_RADIUS_METERS=400

# --- TLS inspecting networks (corporate proxy) ---
# Path inside the api container to the interceptor root CA. See README.
API_EXTRA_CA_CERTS=
