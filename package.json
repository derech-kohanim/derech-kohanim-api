{
  "name": "@derech-kohanim/api",
  "version": "0.1.0",
  "private": true,
  "description": "Derech Kohanim backend - auth, places, zones, routing, voice and live navigation",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/derech-kohanim-api/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "node dist/derech-kohanim-api/src/seed/seed.js",
    "seed:dev": "tsx src/seed/seed.ts",
    "import:areas": "node dist/derech-kohanim-api/scripts/import-areas.js",
    "import:areas:dev": "tsx scripts/import-areas.ts",
    "export:graph-models": "node dist/derech-kohanim-api/scripts/export-graph-models.js",
    "export:graph-models:dev": "tsx scripts/export-graph-models.ts",
    "verify": "tsx scripts/verify.ts",
    "test": "tsx scripts/verify-routing-units.ts && tsx scripts/verify.ts",
    "prisma:generate": "prisma generate",
    "prisma:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/swagger": "^11.0.7",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.5.0",
    "@turf/bbox": "^7.2.0",
    "@turf/boolean-intersects": "^7.2.0",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/distance": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "@turf/length": "^7.2.0",
    "@turf/nearest-point-on-line": "^7.2.0",
    "@turf/point-to-line-distance": "^7.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "google-auth-library": "^9.15.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
