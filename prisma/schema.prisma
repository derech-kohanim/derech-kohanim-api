// Relational data only. Zone geometry lives in PostGIS tables created by
// prisma/migrations/002_postgis_zones.sql and is queried with raw SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(uuid())
  email                String?   @unique
  passwordHash         String?   @map("password_hash")
  googleSub            String?   @unique @map("google_sub")
  displayName          String?   @map("display_name")
  avatarUrl            String?   @map("avatar_url")
  tier                 String    @default("registered")
  providers            String[]  @default([])
  preferences          Json
  acceptedTermsVersion String?   @map("accepted_terms_version")
  acceptedTermsAt      DateTime? @map("accepted_terms_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  refreshTokens    RefreshToken[]
  savedPlaces      SavedPlace[]
  recentPlaces     RecentPlace[]
  navSessions      NavSession[]
  routes           Route[]
  reports          RouteReport[]
  navFeedback      NavFeedback[]
  deletionRequests DeletionRequest[]
  supportReports   SupportReport[]

  @@map("users")
}

/**
 * Someone asking for their account and data to be removed, raised from the public
 * /delete-account page. The row records the request; an operator resolves it from the console.
 * user_id is nulled rather than cascaded when the account goes, so completing a request does
 * not erase the evidence that it was made and handled.
 */
model DeletionRequest {
  id String @id @default(uuid())
  /// The account the email resolved to at submission time, null when none matched.
  userId String? @map("user_id")
  email  String
  /// True when the request arrived from a signed-in session, so the address is proven.
  verified Boolean @default(false)
  reason   String?
  /// pending | completed | rejected
  status String @default("pending")
  /// web | android
  source    String    @default("web")
  note      String?
  handledBy String?   @map("handled_by")
  handledAt DateTime? @map("handled_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@map("deletion_requests")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model TermsDocument {
  version   String
  language  String
  title     String
  body      String
  isCurrent Boolean  @default(false) @map("is_current")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@id([version, language])
  @@map("terms_documents")
}

model SavedPlace {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  label     String
  category  String   @default("other")
  lat       Float
  lng       Float
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_places")
}

model RecentPlace {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  dedupeKey  String   @map("dedupe_key")
  title      String
  subtitle   String?
  lat        Float
  lng        Float
  externalId String?  @map("external_id")
  useCount   Int      @default(1) @map("use_count")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, lastUsedAt])
  @@map("recent_places")
}

// One row per (normalised query, language). Google permits caching geocoding results for
// 30 days; rows older than that are treated as stale and refreshed.
model GeocodeCache {
  query     String
  language  String
  results   Json
  hits      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([query, language])
  @@map("geocode_cache")
}

model PlaceDetailsCache {
  externalId String   @map("external_id")
  language   String
  payload    Json
  hits       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([externalId, language])
  @@map("place_details_cache")
}

// Short-lived cache for Places (New) text-search results. Stricter than geocoding: the
// place_id inside each row is durable, the names/addresses are a performance cache only and
// are refreshed within the window set by PLACES_CACHE_TTL_DAYS.
model PlacesCache {
  query     String
  language  String
  results   Json
  hits      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([query, language])
  @@map("places_cache")
}

model Route {
  id     String  @id
  userId String? @map("user_id")
  /// Groups every route one compute produced, so the console can show which alternatives were
  /// offered next to the one a navigation session actually used.
  planId String? @map("plan_id")
  /// Where this route sat in its plan: primary | alternative | unavoided.
  role   String  @default("primary")
  /// Position within the plan, 0 for the recommended route.
  rank   Int     @default(0)

  request   Json
  result    Json
  createdAt DateTime @default(now()) @map("created_at")

  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  navSessions NavSession[]
  reports     RouteReport[]
  navFeedback NavFeedback[]

  @@index([userId])
  @@index([planId])
  @@index([createdAt])
  @@map("routes")
}

// Community reports raised against a computed route, surfaced back in its event bundle.
model RouteReport {
  id        String   @id @default(uuid())
  routeId   String   @map("route_id")
  userId    String?  @map("user_id")
  type      String
  lat       Float
  lng       Float
  createdAt DateTime @default(now()) @map("created_at")

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([routeId])
  @@map("route_reports")
}

// End-of-trip feedback: a good/bad rating for a completed route, with optional free text on a
// 'bad' rating. Guests may submit anonymously, so userId is nullable.
// The route reference is nulled rather than cascaded when a route is purged by retention, so a
// driver's rating of the service outlives the 30 day window on the route data itself.
model NavFeedback {
  id        String   @id @default(uuid())
  routeId   String?  @map("route_id")
  userId    String?  @map("user_id")
  rating    String
  text      String?
  createdAt DateTime @default(now()) @map("created_at")

  route Route? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([routeId])
  @@map("nav_feedback")
}

model NavSession {
  id           String    @id @default(uuid())
  userId       String?   @map("user_id")
  routeId      String    @map("route_id")
  status       String    @default("navigating")
  simulated    Boolean   @default(false)
  stringency   String    @default("basic")
  trafficAware Boolean   @default(false) @map("traffic_aware")
  engine       String
  lastLat      Float?    @map("last_lat")
  lastLng      Float?    @map("last_lng")
  offRouteCount Int      @default(0) @map("off_route_count")
  rerouteCount Int       @default(0) @map("reroute_count")
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")

  user   User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  route  Route             @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routes NavSessionRoute[]

  @@index([userId])
  @@map("nav_sessions")
}

/**
 * The trail of routes a session actually drove: the one it started on, then one row per
 * reroute. NavSession.routeId only ever holds the current route, so without this the original
 * route is lost the moment a driver goes off route - exactly the case worth debugging.
 * route_id is a plain reference, not a foreign key: retention purges sessions and routes
 * together, and a missing route must not take the trail with it.
 */
model NavSessionRoute {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  routeId   String   @map("route_id")
  /// initial | reroute
  reason    String   @default("initial")
  createdAt DateTime @default(now()) @map("created_at")

  session NavSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("nav_session_routes")
}

// Per-compute timing/debug telemetry for POST /api/routes/compute. Created out of band from an
// interceptor + RoutingService, never on the route's return path, so recording cannot slow or
// break a compute. The PostGIS geometry itself is not stored here; route_id points at the
// stored Route (request + result + debug) when a fuller payload is needed.
model RouteComputeStat {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now()) @map("created_at")
  provider         String
  engine           String
  computeMs        Int      @map("compute_ms")
  handlingMs       Int      @map("handling_ms")
  alternativeCount Int      @default(0) @map("alternative_count")
  verifiedClean    Boolean  @default(false) @map("verified_clean")
  stringency       String
  mode             String
  originLat        Float    @map("origin_lat")
  originLng        Float    @map("origin_lng")
  destLat          Float    @map("dest_lat")
  destLng          Float    @map("dest_lng")
  distanceMeters   Int?     @map("distance_meters")
  durationSeconds  Int?     @map("duration_seconds")
  avoidDangerZones Boolean  @default(true) @map("avoid_danger_zones")
  avoidTolls       Boolean  @default(false) @map("avoid_tolls")
  routeId          String?  @map("route_id")
  userId           String?  @map("user_id")

  @@index([createdAt])
  @@map("route_compute_stats")
}

model VoicePack {
  id        String   @id
  language  String
  voiceId   String   @map("voice_id")
  version   Int      @default(1)
  updatedAt DateTime @default(now()) @map("updated_at")

  clips VoiceClip[]

  @@unique([language, voiceId])
  @@map("voice_packs")
}

model VoiceClip {
  id         String   @id @default(uuid())
  packId     String   @map("pack_id")
  clipKey    String   @map("clip_key")
  role       String
  text       String
  audioPath  String   @map("audio_path")
  source     String   @default("recorded")
  durationMs Int      @map("duration_ms")
  hash       String
  // Populated only for generated clips; recorded seed clips carry metadata only and have no
  // bytes yet, so a request for their audio reports the clip as missing.
  audio       Bytes?  @map("audio")
  contentType String? @map("content_type")
  createdAt   DateTime @default(now()) @map("created_at")

  pack VoicePack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, clipKey])
  @@map("voice_clips")
}

// A report or feedback from a signed-in user, filed as an issue in the private support repository
// when GitHub is configured. Kept here either way, for the admin console.
model SupportReport {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  kind         String
  message      String
  platform     String
  appVersion   String   @map("app_version")
  device       String?
  routeId      String?  @map("route_id")
  zoneId       Int?     @map("zone_id")
  lat          Float?
  lng          Float?
  replyByEmail Boolean  @default(false) @map("reply_by_email")
  issueNumber  Int?     @map("issue_number")
  issueUrl     String?  @map("issue_url")
  merged       Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("support_reports")
}
